rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isContractParticipant(contractId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/lend_borrow_contracts/$(contractId))
        && request.auth.uid in get(
          /databases/$(database)/documents/lend_borrow_contracts/$(contractId)
        ).data.participantIds;
    }

    function canFulfillPostViaContract(contractId, postId) {
      let contract = get(
        /databases/$(database)/documents/lend_borrow_contracts/$(contractId)
      ).data;
      return request.auth.uid in contract.participantIds
        && contract.postId == postId;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isKycSubmission(userId) {
      return isOwner(userId)
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.keys().hasAll([
          'kycSubmittedAt',
          'selfieImageUrl',
          'cnicFrontImageUrl',
          'cnicBackImageUrl'
        ])
        && (
          !('verificationStatus' in resource.data)
          || resource.data.verificationStatus in ['rejected', 'pending']
        );
    }

    function canFulfillPostViaClaim(claimId, postId) {
      let claim = get(
        /databases/$(database)/documents/lost_found_claims/$(claimId)
      ).data;
      return request.auth.uid in claim.participantIds
        && claim.postId == postId;
    }

    function isNotBanned() {
      return request.auth != null
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true
        );
    }

    function isClaimParticipant(claimId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/lost_found_claims/$(claimId))
        && request.auth.uid in get(
          /databases/$(database)/documents/lost_found_claims/$(claimId)
        ).data.participantIds;
    }

    match /admins/{adminId} {
      // Auth users may list admin IDs so KYC submit can notify admins.
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        request.resource.data.verificationStatus == resource.data.verificationStatus
        || isKycSubmission(userId)
      );
      allow update: if isAdmin() && request.auth.uid != userId;

      match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow delete: if false;
      }

      match /announcement_reads/{announcementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null
        && (resource.data.active == true || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNotBanned();
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      allow update: if request.auth != null
        && request.resource.data.listingStatus == 'fulfilled'
        && request.resource.data.completedContractId is string
        && (
          canFulfillPostViaContract(
            request.resource.data.completedContractId,
            postId
          )
          || canFulfillPostViaClaim(
            request.resource.data.completedContractId,
            postId
          )
        );
    }

    match /lost_found_claims/{claimId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      match /handshake_logs/{logId} {
        allow read, create: if request.auth != null
          && isClaimParticipant(claimId);
      }
    }

    match /lend_borrow_contracts/{contractId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      match /handshake_logs/{logId} {
        allow read, create: if request.auth != null
          && isContractParticipant(contractId);
      }
    }
  }
}
